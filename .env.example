# Example environment configuration. Variable NAMES and placeholders only: never put real passwords in this file or in Git.
# Copy to a file named .env (it is git-ignored). run_local.bat / run_local.sh read .env automatically.
# Use one KEY=value per line, no quotes, no trailing comments.

# Initial passwords for the two accounts created on first start (min 10 chars, upper+lower+digit).
# The CHANGE_ME placeholders below are deliberately rejected by the app: replace both before starting.
# If left out locally, random passwords are generated and printed once by the start script.
# REQUIRED on a public deployment.
LOAN_APP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
LOAN_APP_OFFICER_PASSWORD=CHANGE_ME_OFFICER_PASSWORD

# Set to 1 on any public deployment: the app refuses to create accounts without the two passwords above.
# LOAN_APP_REQUIRE_ENV_PASSWORDS=1

# Where the database, uploaded documents and reports are stored (default: data/app inside the project).
# On Render this is the persistent disk: /var/data/loan_app
# LOAN_APP_DATA_DIR=data/app

# Optional overrides (each defaults to a path inside LOAN_APP_DATA_DIR).
# LOAN_APP_DB=
# LOAN_APP_UPLOADS=
# LOAN_APP_REPORTS=

# Optional limits.
# LOAN_APP_MAX_UPLOAD_MB=10
# LOAN_APP_SESSION_MINUTES=30

# Local port (run_local scripts only; default 8501).
# LOAN_APP_PORT=8501
